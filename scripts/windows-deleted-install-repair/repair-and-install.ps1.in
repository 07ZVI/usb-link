param()
$ErrorActionPreference = 'Stop'
$exitCode = 1
$transcriptStarted = $false
$held = @()
try {
    if (-not [Environment]::Is64BitOperatingSystem -or $env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64') { throw 'This kit requires Windows x64 (Intel/AMD).' }
    $admin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    if (-not $admin) {
        $powerShell = Join-Path $PSHOME 'powershell.exe'
        $arguments = '-NoProfile -ExecutionPolicy Bypass -File "' + $PSCommandPath + '"'
        $process = Start-Process -FilePath $powerShell -ArgumentList $arguments -Verb RunAs -Wait -PassThru
        exit $process.ExitCode
    }
    if ([Diagnostics.Process]::GetCurrentProcess().SessionId -eq 0) { throw 'Run this kit from your Windows desktop, not a service/session-zero process.' }
    $logDir = Join-Path $PSScriptRoot 'logs'
    New-Item -ItemType Directory -Path $logDir -Force | Out-Null
    Start-Transcript -Path (Join-Path $logDir ('repair-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [guid]::NewGuid().ToString('N') + '.txt')) | Out-Null
    $transcriptStarted = $true
    $pins = @{
        'repair-deleted-install.exe' = '@REPAIR_SHA@'
        'USB-Link-0.9.5-windows-x64.exe' = '@INSTALLER_SHA@'
        'offline-components\prepare-components.exe' = '@COMPONENT_SHA@'
    }
    foreach ($relative in $pins.Keys) {
        $path = Join-Path $PSScriptRoot $relative
        if ((Get-Item -LiteralPath $path).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw ('Redirected executable: ' + $relative) }
        $held += [IO.File]::Open($path, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
        if ((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash -ne $pins[$relative]) { throw ('Checksum mismatch: ' + $relative) }
    }
    $repair = Join-Path $PSScriptRoot 'repair-deleted-install.exe'
    Write-Host 'USB Link 0.9.5 - repair deleted installation'
    Write-Host 'Checking exact residual service/registration before any component preparation.'
    & $repair --check-only
    if ($LASTEXITCODE -ne 0) { throw 'Residual state differs from the reviewed report. Nothing was removed.' }
    Write-Host 'Verifying local/offline components; existing verified components are reused.'
    Write-Host 'If official Apple setup opens, finish its wizard. No device is force-bound.'
    & (Join-Path $PSScriptRoot 'offline-components\prepare-components.exe')
    if ($LASTEXITCODE -ne 0) { throw 'Component preparation failed or requires restart. No residual service/registration was removed.' }
    & $repair
    $exitCode = $LASTEXITCODE
    if ($exitCode -ne 0) { Write-Host 'Repair/installation is not verified. Return this folder with its logs.' -ForegroundColor Red }
} catch {
    Write-Host $_.Exception.Message -ForegroundColor Red
    $exitCode = 1
} finally {
    foreach ($file in $held) { $file.Dispose() }
    if ($transcriptStarted) { Stop-Transcript | Out-Null }
}
exit $exitCode
