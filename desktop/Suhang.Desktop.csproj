<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <AssemblyName>USBLink.Desktop</AssemblyName><Version Condition="'$(Version)' == ''">0.9.0</Version>
  <ApplicationManifest>app.manifest</ApplicationManifest>
  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  <NuGetAudit>true</NuGetAudit>
 </PropertyGroup>
 <ItemGroup>
  <Compile Remove="obj/**/*.cs;bin/**/*.cs" />
  <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
  <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
  <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
 </ItemGroup>
</Project>
